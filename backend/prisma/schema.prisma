generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ==========================================
// USUÁRIOS DO SISTEMA (ADMINISTRADOR & PROFESSORES)
// ==========================================
model Usuario {
  id                  String   @id @default(uuid())
  nome                String
  email               String   @unique
  senha               String
  cargo               String   @default("PROFESSOR") // Valores: "ADMIN" ou "PROFESSOR"
  telefone            String?
  modalidade          String   @default("Muay Thai") // "Muay Thai", "Jiu-Jitsu", "Boxe", "MMA", "Taekwondo"
  graduacao           String?  @default("Prajied Azul Escuro e Preto") // Faixa / Prajied
  tempoPratica        String?  // Tempo de prática/treino (Ex: "10 anos de prática")
  tempoDocencia       String?  // Tempo lecionando / dando aulas (Ex: "6 anos ministrando aulas")
  tempoAula           String?  @default("60 min") // Duração padrão da aula (Ex: "60 min", "90 min")
  horariosAula        String?  // Horários / Grade de aulas (Ex: "Seg, Qua e Sex - 19:00")
  cargaHorariaSemanal String?  // Carga horária semanal (Ex: "6h semanais")
  prajied             String?  @default("Prajied Azul Escuro e Preto") // Mantido para compatibilidade
  ativo               Boolean  @default(true)
  criadoEm            DateTime @default(now())
}

// ==========================================
// ALUNOS & MATRÍCULAS
// ==========================================
model Aluno {
  id             String        @id @default(uuid())
  nome           String
  email          String?       @unique
  telefone       String?
  cpf            String?       @unique
  senha          String?       // Senha de acesso
  primeiroAcesso Boolean       @default(true) // Obriga a redefinir no 1º acesso
  plano          String?       // Valores: DIARIA, 2x na semana, 3x na semana, Todos os Horários
  modalidade     String?       @default("Muay Thai") // Muay Thai, Jiu-Jitsu, Boxe, MMA, Taekwondo
  graduacao      String?       @default("Branco") // Faixa ou Prajied ou Nível
  prajied        String        @default("Branco") // Graduação do Muay Thai (retrocompatibilidade)
  criadoEm       DateTime      @default(now())
  
  mensalidades   Mensalidade[]
  presencas      AgendamentoPresenca[]
}

model Mensalidade {
  id             String          @id @default(uuid())
  valor          Float
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         String          @default("PENDENTE") // Valores: PENDENTE, PAGO, ATRASADO
  
  alunoId        String
  aluno          Aluno           @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  
  criadoEm       DateTime        @default(now())
}

// ==========================================
// AGENDA, AULAS & FREQUÊNCIA DETALHADA
// ==========================================
model EventoDeAula {
  id          String                @id @default(uuid())
  titulo      String
  dataInicio  DateTime
  dataFim     DateTime
  
  agendamentos AgendamentoPresenca[]
  
  criadoEm    DateTime              @default(now())
}

model AgendamentoPresenca {
  id                 String        @id @default(uuid())
  // Status: AGENDADO, PRESENTE, FALTA (AUSENTE), DOENCA (FALTA_DOENCA), JUSTIFICADO
  status             String        @default("AGENDADO")
  fotoComprovanteUrl String?

  alunoId            String
  aluno              Aluno         @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  
  eventoId           String?
  evento             EventoDeAula? @relation(fields: [eventoId], references: [id])
  
  data               DateTime      @default(now())
  justificativa      String?       // Detalhe ou atestado
  tipoJustificativa  String?       // DOENCA, ATESTADO, TRABALHO, PESSOAL, OUTRO

  criadoEm           DateTime      @default(now())
}

model AgendamentoExperimental {
  id            String    @id @default(uuid())
  nome          String
  telefone      String
  data          String
  horario       String
  status        String    @default("PENDENTE") // PENDENTE, REALIZADA, FECHOU_CONTRATO, DESISTIU
  dataRealizada DateTime?
  observacao    String?
  criadoEm      DateTime  @default(now())
}

// ==========================================
// MURAL DE AVISOS (PROFESSORES & ADMIN)
// ==========================================
model Aviso {
  id          String   @id @default(uuid())
  titulo      String
  conteudo    String
  tipo        String   @default("GERAL") // GERAL, URGENTE, GRADUACAO, EVENTO
  autorNome   String   @default("Felipe Borü")
  autorCargo  String   @default("Professor") // "Administrador" ou "Professor"
  fixado      Boolean  @default(false)
  criadoEm    DateTime @default(now())
}

// ==========================================
// LOJA & MERCADO BORÜ (BETA)
// ==========================================
model Produto {
  id          String   @id @default(uuid())
  nome        String
  categoria   String   // PROTETOR_BUCAL, LUVAS, CANELEIRAS, BANDAGENS, ALIMENTOS
  preco       Float
  estoque     Int      @default(0)
  descricao   String?
  imagemUrl   String?
  disponivel  Boolean  @default(true)
  criadoEm    DateTime @default(now())
}
